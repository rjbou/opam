### <ONE/repo>
opam-version: "2.0"
### <ONE/packages/foo/foo.1/opam>
opam-version: "2.0"
build: [ "touch" "built.%{name}%" ]
install: [ "cp" "built.%{name}%" "%{lib}%/" ]
